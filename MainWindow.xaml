                                        <TextBlock x:Name="TxtProbNormalCur" Text="当前: -" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="BoxProbNormal" Style="{StaticResource DarkInput}" Text="80.3" TextChanged="RarityBox_TextChanged" KeyDown="RarityBox_KeyDown"/>
                                            <TextBlock Grid.Column="1" Text="%" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Advanced -->
                                <Border Background="#151825" BorderBrush="#2D523D" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="3,0">
                                    <StackPanel>
                                        <TextBlock Text="高级" FontSize="13.5" FontWeight="Bold" Foreground="#99D9A6"/>
                                        <TextBlock x:Name="TxtProbAdvancedCur" Text="当前: -" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="BoxProbAdvanced" Style="{StaticResource DarkInput}" Text="15" TextChanged="RarityBox_TextChanged" KeyDown="RarityBox_KeyDown"/>
                                            <TextBlock Grid.Column="1" Text="%" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Rare -->
                                <Border Background="#151825" BorderBrush="#2E4775" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="3,0">
                                    <StackPanel>
                                        <TextBlock Text="稀有" FontSize="13.5" FontWeight="Bold" Foreground="#99BFFF"/>
                                        <TextBlock x:Name="TxtProbRareCur" Text="当前: -" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="BoxProbRare" Style="{StaticResource DarkInput}" Text="4.5" TextChanged="RarityBox_TextChanged" KeyDown="RarityBox_KeyDown"/>
                                            <TextBlock Grid.Column="1" Text="%" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Legendary -->
                                <Border Background="#151825" BorderBrush="#6B441C" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="3,0">
                                    <StackPanel>
                                        <TextBlock Text="传说" FontSize="13.5" FontWeight="Bold" Foreground="#F59E3A"/>
                                        <TextBlock x:Name="TxtProbLegendaryCur" Text="当前: -" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="BoxProbLegendary" Style="{StaticResource DarkInput}" Text="0.2" TextChanged="RarityBox_TextChanged" KeyDown="RarityBox_KeyDown"/>
                                            <TextBlock Grid.Column="1" Text="%" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Prism -->
                                <Border Background="#151825" BorderBrush="#6B2FA0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="棱彩" FontSize="13.5" FontWeight="Bold" Foreground="#D966FF"/>
                                        <TextBlock x:Name="TxtProbPrismCur" Text="当前: -" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="BoxProbPrism" Style="{StaticResource DarkInput}" Text="0" TextChanged="RarityBox_TextChanged" KeyDown="RarityBox_KeyDown"/>
                                            <TextBlock Grid.Column="1" Text="%" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <WrapPanel VerticalAlignment="Center">
                                <Button Style="{StaticResource PrimaryBtn}" Content="应用稀有度概率" Margin="0,0,8,0" Click="BtnApplyRarity_Click"/>
                                <Button Style="{StaticResource GoldBtn}" Content="100% 传说" Margin="0,0,8,0" Click="BtnPresetLegendary_Click"/>
                                <Button Style="{StaticResource ModernBtn}" BorderBrush="#A855F7" Foreground="#E9D5FF" Background="#3B1D5A" Content="100% 棱彩" Margin="0,0,8,0" Click="BtnPresetPrism_Click"/>
                                <Button Style="{StaticResource ModernBtn}" Content="传说50% + 棱彩50%" Margin="0,0,8,0" Click="BtnPresetHalfLegPrism_Click"/>
                                <Button Style="{StaticResource ModernBtn}" Content="恢复默认" Click="BtnRestoreRarity_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Slot Force Win Probability -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="7" Background="#121420" BorderBrush="#2D334D" BorderThickness="1" Margin="0,0,12,0">
                                <Image Source="pack://application:,,,/Assets/icons/joker_big.png" Style="{StaticResource GameIcon}" Width="24" Height="22"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="老虎机强制中奖概率 (forceWinProb)" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource AccentGold}"/>
                                    <TextBlock x:Name="TxtForceWinCur" Text="当前: -" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource AccentGreen}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="直接修改底层中奖概率（设为 100% 每次旋转必中，且清除压制概率）" FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="BoxForceWinProb" Style="{StaticResource DarkInput}" Width="74" Text="100" KeyDown="ForceWinBox_KeyDown"/>
                                <TextBlock Text="%" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="5,0,10,0"/>
                                <Button Style="{StaticResource PrimaryBtn}" Content="应用" Margin="0,0,6,0" Click="BtnApplyForceWin_Click"/>
                                <Button Style="{StaticResource SuccessBtn}" Content="100% 必中" Margin="0,0,6,0" Click="BtnForceWin100_Click"/>
                                <Button Style="{StaticResource ModernBtn}" Content="归零" Click="BtnForceWin0_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card 3: Class Symbol Weights -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="符号出现权重（控制老虎机各职业符号出率）" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentGold}"/>
                                <TextBlock Text="调高目标符号权重即可定向抽对应职业" FontSize="11.5" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <UniformGrid Columns="6" Margin="0,0,0,12">
                                <Border Background="#151825" BorderBrush="#262B42" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,6,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Image Source="pack://application:,,,/Assets/icons/sym_W.png" Style="{StaticResource GameIcon}" Width="20" Height="20" Margin="0,0,6,0"/>
                                            <TextBlock Text="W 剑" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtSymWCur" Text="当前: -" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="BoxSymW" Style="{StaticResource DarkInput}" Text="20" KeyDown="SymbolBox_KeyDown"/>
                                            <TextBlock Grid.Column="1" Text="%" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Background="#151825" BorderBrush="#262B42" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="3,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Image Source="pack://application:,,,/Assets/icons/sym_A.png" Style="{StaticResource GameIcon}" Width="20" Height="20" Margin="0,0,6,0"/>
                                            <TextBlock Text="A 弓" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtSymACur" Text="当前: -" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="BoxSymA" Style="{StaticResource DarkInput}" Text="20" KeyDown="SymbolBox_KeyDown"/>
                                            <TextBlock Grid.Column="1" Text="%" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Background="#151825" BorderBrush="#262B42" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="3,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Image Source="pack://application:,,,/Assets/icons/sym_S.png" Style="{StaticResource GameIcon}" Width="20" Height="20" Margin="0,0,6,0"/>
                                            <TextBlock Text="S 枪" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtSymSCur" Text="当前: -" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="BoxSymS" Style="{StaticResource DarkInput}" Text="20" KeyDown="SymbolBox_KeyDown"/>
                                            <TextBlock Grid.Column="1" Text="%" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Background="#151825" BorderBrush="#262B42" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="3,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Image Source="pack://application:,,,/Assets/icons/sym_H.png" Style="{StaticResource GameIcon}" Width="20" Height="20" Margin="0,0,6,0"/>
                                            <TextBlock Text="H 骑" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtSymHCur" Text="当前: -" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="BoxSymH" Style="{StaticResource DarkInput}" Text="15" KeyDown="SymbolBox_KeyDown"/>
                                            <TextBlock Grid.Column="1" Text="%" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Background="#151825" BorderBrush="#262B42" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="3,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Image Source="pack://application:,,,/Assets/icons/sym_M.png" Style="{StaticResource GameIcon}" Width="20" Height="20" Margin="0,0,6,0"/>
                                            <TextBlock Text="M 法" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtSymMCur" Text="当前: -" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="BoxSymM" Style="{StaticResource DarkInput}" Text="15" KeyDown="SymbolBox_KeyDown"/>
                                            <TextBlock Grid.Column="1" Text="%" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Background="#151825" BorderBrush="#262B42" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="6,0,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Image Source="pack://application:,,,/Assets/icons/sym_D.png" Style="{StaticResource GameIcon}" Width="20" Height="20" Margin="0,0,6,0"/>
                                            <TextBlock Text="D 皇冠" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtSymDCur" Text="当前: -" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="BoxSymD" Style="{StaticResource DarkInput}" Text="10" KeyDown="SymbolBox_KeyDown"/>
                                            <TextBlock Grid.Column="1" Text="%" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryBtn}" Content="应用符号权重" Margin="0,0,8,0" Click="BtnApplySymbols_Click"/>
                                <Button Style="{StaticResource ModernBtn}" Content="六系均分 (16.7%)" Margin="0,0,8,0" Click="BtnEqualSymbols_Click"/>
                                <Button Style="{StaticResource ModernBtn}" Content="恢复默认权重" Click="BtnRestoreSymbols_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- PAGE 3: Roster Units -->
            <Grid x:Name="PageUnits" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Bulk Boost Toolbar -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Style="{StaticResource PrimaryBtn}" Margin="0,0,8,0" Click="BtnRefreshUnits_Click" Content="刷新单位列表"/>
                    <Button Style="{StaticResource DangerBtn}" Margin="0,0,8,0" Click="BtnBoostAtk_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/icons/atk.png" Style="{StaticResource GameIcon}" Width="14" Height="14" Margin="0,0,6,0"/>
                            <TextBlock Text="全员攻击 ×2"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SuccessBtn}" Margin="0,0,8,0" Click="BtnBoostHp_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/icons/hp.png" Style="{StaticResource GameIcon}" Width="14" Height="12" Margin="0,0,6,0"/>
                            <TextBlock Text="全员生命 ×2"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GoldBtn}" Click="BtnBoostAspd_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/icons/aspd.png" Style="{StaticResource GameIcon}" Width="14" Height="14" Margin="0,0,6,0"/>
                            <TextBlock Text="全员攻速 ×1.5"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Units Table -->
                <DataGrid x:Name="GridUnits" Grid.Row="1" Style="{StaticResource DarkDataGrid}" AutoGenerateColumns="False"
                          SelectionChanged="GridUnits_SelectionChanged" Margin="0,0,0,12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="46"/>
                        <DataGridTextColumn Header="符号" Binding="{Binding Symbol}" Width="58"/>
                        <DataGridTextColumn Header="单位" Binding="{Binding DisplayName}" Width="1.4*"/>
                        <DataGridTextColumn Header="品质" Binding="{Binding GradeLabel}" Width="74"/>
                        <DataGridTextColumn Header="星级" Binding="{Binding Rank, StringFormat=0}" Width="62"/>
                        <DataGridTextColumn Header="吸收 LV" Binding="{Binding AbsorbLv, StringFormat=0}" Width="76"/>
                        <DataGridTextColumn Header="攻击力" Binding="{Binding Atk, StringFormat=0.##}" Width="*"/>
                        <DataGridTextColumn Header="生命值" Binding="{Binding Hp, StringFormat=0.##}" Width="*"/>
                        <DataGridTextColumn Header="攻速" Binding="{Binding Aspd, StringFormat=0.###}" Width="82"/>
                        <DataGridTextColumn Header="刻印槽" Binding="{Binding MaxImprintSlots, StringFormat=0}" Width="72"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Selected Unit Editor Card -->
                <Border Grid.Row="2" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="精准编辑选中单位（同步战场实体，写入前实时校验身份）" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentGold}" Margin="0,0,0,10"/>
                        <WrapPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                                <Image Source="pack://application:,,,/Assets/icons/atk.png" Style="{StaticResource GameIcon}" Width="15" Height="15" Margin="0,0,6,0"/>
                                <TextBlock Text="攻击" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="BoxUnitAtk" Style="{StaticResource DarkInput}" Width="86" KeyDown="UnitBox_KeyDown"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                                <Image Source="pack://application:,,,/Assets/icons/hp.png" Style="{StaticResource GameIcon}" Width="15" Height="13" Margin="0,0,6,0"/>
                                <TextBlock Text="生命" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="BoxUnitHp" Style="{StaticResource DarkInput}" Width="86" KeyDown="UnitBox_KeyDown"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                                <Image Source="pack://application:,,,/Assets/icons/aspd.png" Style="{StaticResource GameIcon}" Width="14" Height="14" Margin="0,0,6,0"/>
                                <TextBlock Text="攻速" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="BoxUnitAspd" Style="{StaticResource DarkInput}" Width="72" KeyDown="UnitBox_KeyDown"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                                <Image Source="pack://application:,,,/Assets/icons/upgrade.png" Style="{StaticResource GameIcon}" Width="13" Height="16" Margin="0,0,6,0"/>
                                <TextBlock Text="吸收LV" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="BoxUnitAbsorb" Style="{StaticResource DarkInput}" Width="66" KeyDown="UnitBox_KeyDown"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                                <Image Source="pack://application:,,,/Assets/icons/star.png" Style="{StaticResource GameIcon}" Width="15" Height="15" Margin="0,0,6,0"/>
                                <TextBlock Text="刻印槽" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="BoxUnitSlots" Style="{StaticResource DarkInput}" Width="58" KeyDown="UnitBox_KeyDown"/>
                            </StackPanel>

                            <Button Style="{StaticResource SuccessBtn}" Content="应用修改" Padding="16,6" Click="BtnApplyUnit_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- PAGE 3: Operation Log -->
            <Border x:Name="PageLogs" Style="{StaticResource CardBorder}" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="内存读写与安全防护日志" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentGold}" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource ModernBtn}" Content="清空日志" Padding="10,4" HorizontalAlignment="Right" Click="BtnClearLog_Click"/>
                    </Grid>
                    <TextBox x:Name="TxtLog" Grid.Row="1" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                             Background="{StaticResource BgInput}" Foreground="{StaticResource TextSecondary}"
                             BorderBrush="{StaticResource BorderBrushSubtle}" BorderThickness="1"
                             FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="12" Padding="10"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. Bottom Live Feedback Bar -->
        <Border Grid.Row="3" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderBrushSubtle}" BorderThickness="0,1,0,0" Padding="18,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="ToastDot" Grid.Column="0" Width="7" Height="7" Fill="{StaticResource AccentGreen}" Margin="0,0,8,0"/>
