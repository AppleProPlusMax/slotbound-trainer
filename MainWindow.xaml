<Window x:Class="SlotboundTrainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AppTitle}"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="930" Height="815"
        MinWidth="880" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgCanvas}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Top Header Bar -->
        <Border Grid.Row="0" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderBrushSubtle}" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Native Slotbound Game Icon -->
                <Border Grid.Column="0" Width="46" Height="46" CornerRadius="10" Background="#131522"
                        BorderBrush="#353B5B" BorderThickness="1" Margin="0,0,14,0">
                    <Image Source="pack://application:,,,/Assets/app.ico" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <!-- Connection Status & Live Run Info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource AccentGold}" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtStatus" Text="{DynamicResource StatusSearching}" FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource AccentGold}"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtGameInfo" Text="-"
                               FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Header Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnLang" Style="{StaticResource ModernBtn}" Content="{DynamicResource BtnLangSwitch}"
                            MinWidth="54" Margin="0,0,8,0" Click="BtnLang_Click" ToolTip="Switch Language / 切换中英文"/>
                    <Button x:Name="BtnUnlockAll" Style="{StaticResource DangerBtn}" Content="{DynamicResource BtnUnlockAll}" Margin="0,0,8,0" Click="BtnUnlockAll_Click"/>
                    <Button x:Name="BtnAttach" Style="{StaticResource PrimaryBtn}" Content="{DynamicResource BtnAttach}" Click="BtnAttach_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Navigation Bar -->
        <Border Grid.Row="1" Background="#151824" BorderBrush="{StaticResource BorderBrushSubtle}" BorderThickness="0,0,0,1" Padding="18,8">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="NavResources" Style="{StaticResource NavTabRadio}" IsChecked="True" Checked="NavTab_Checked">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/icons/gold.png" Style="{StaticResource GameIcon}" Width="16" Height="16" Margin="0,0,7,0"/>
                        <TextBlock Text="{DynamicResource NavResources}" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavOdds" Style="{StaticResource NavTabRadio}" Checked="NavTab_Checked">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/icons/odds_book.png" Style="{StaticResource GameIcon}" Width="20" Height="14" Margin="0,0,7,0"/>
                        <TextBlock Text="{DynamicResource NavOdds}" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavUnits" Style="{StaticResource NavTabRadio}" Checked="NavTab_Checked">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/icons/battle.png" Style="{StaticResource GameIcon}" Width="16" Height="16" Margin="0,0,7,0"/>
                        <TextBlock Text="{DynamicResource NavUnits}" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavLogs" Style="{StaticResource NavTabRadio}" Checked="NavTab_Checked">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/icons/core.png" Style="{StaticResource GameIcon}" Width="20" Height="14" Margin="0,0,7,0"/>
                        <TextBlock Text="{DynamicResource NavLogs}" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- 3. Main Content Pages -->
        <Grid Grid.Row="2" Margin="18,14">

            <!-- PAGE 1: Resources & Switches -->
            <ScrollViewer x:Name="PageResources" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Card: Core Numeric Resources -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="{DynamicResource CardResourcesTitle}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentGold}"/>
                                <TextBlock Text="{DynamicResource CardResourcesHint}" FontSize="11.5"
                                           Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Column Header Hint -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="175"/>
                                    <ColumnDefinition Width="115"/>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="185"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource ColItem}" FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="38,0,0,0"/>
                                <TextBlock Grid.Column="1" Text="{DynamicResource ColCurrent}" FontSize="11.5" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Grid.Column="2" Text="{DynamicResource ColTarget}" FontSize="11.5" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Grid.Column="4" Text="{DynamicResource ColQuick}" FontSize="11.5" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Grid.Column="5" Text="{DynamicResource ColLock}" FontSize="11.5" Foreground="{StaticResource TextMuted}"/>
                            </Grid>

                            <!-- Row 1: Coins -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="175"/>
                                    <ColumnDefinition Width="115"/>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="185"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="6" Background="#121420" BorderBrush="#2D334D" BorderThickness="1" Margin="0,0,10,0">
                                        <Image Source="pack://application:,,,/Assets/icons/gold.png" Style="{StaticResource GameIcon}" Width="18" Height="18"/>
                                    </Border>
                                    <TextBlock Text="{DynamicResource ResCoins}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtCoinsCur" Grid.Column="1" Text="-" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentGold}" VerticalAlignment="Center"/>
                                <TextBox x:Name="BoxCoins" Grid.Column="2" Style="{StaticResource DarkInput}" Text="99999" Margin="0,0,8,0" KeyDown="Input_KeyDown" Tag="coins"/>
                                <Button Grid.Column="3" Style="{StaticResource PrimaryBtn}" Content="{DynamicResource BtnSet}" Padding="8,5" Margin="0,0,8,0" Click="BtnSetCoins_Click"/>
                                <StackPanel Grid.Column="4" Orientation="Horizontal">
                                    <Button Style="{StaticResource ModernBtn}" Content="+1000" Width="76" Padding="6,5" Margin="0,0,6,0" Click="BtnAddCoins1k_Click"/>
                                    <Button Style="{StaticResource ModernBtn}" Content="+10000" Width="82" Padding="6,5" Click="BtnAddCoins10k_Click"/>
                                </StackPanel>
                                <CheckBox x:Name="SwLockCoins" Grid.Column="5" Style="{StaticResource ToggleSwitch}" Content="{DynamicResource LblLock}"/>
                            </Grid>

                            <!-- Row 2: Essence (Jungsu) -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="175"/>
                                    <ColumnDefinition Width="115"/>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="185"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="6" Background="#121420" BorderBrush="#2D334D" BorderThickness="1" Margin="0,0,10,0">
                                        <Image Source="pack://application:,,,/Assets/icons/essence.png" Style="{StaticResource GameIcon}" Width="14" Height="20"/>
                                    </Border>
                                    <TextBlock Text="{DynamicResource ResEssence}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtJungsuCur" Grid.Column="1" Text="-" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold" Foreground="#60A5FA" VerticalAlignment="Center"/>
                                <TextBox x:Name="BoxJungsu" Grid.Column="2" Style="{StaticResource DarkInput}" Text="999" Margin="0,0,8,0" KeyDown="Input_KeyDown" Tag="jungsu"/>
                                <Button Grid.Column="3" Style="{StaticResource PrimaryBtn}" Content="{DynamicResource BtnSet}" Padding="8,5" Margin="0,0,8,0" Click="BtnSetJungsu_Click"/>
                                <StackPanel Grid.Column="4" Orientation="Horizontal">
                                    <Button Style="{StaticResource ModernBtn}" Content="+50" Width="76" Padding="6,5" Margin="0,0,6,0" Click="BtnAddJungsu50_Click"/>
                                    <Button Style="{StaticResource ModernBtn}" Content="+500" Width="82" Padding="6,5" Click="BtnAddJungsu500_Click"/>
                                </StackPanel>
                                <CheckBox x:Name="SwLockJungsu" Grid.Column="5" Style="{StaticResource ToggleSwitch}" Content="{DynamicResource LblLock}"/>
                            </Grid>

                            <!-- Row 3: Spins Left -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="175"/>
                                    <ColumnDefinition Width="115"/>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="185"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="6" Background="#121420" BorderBrush="#2D334D" BorderThickness="1" Margin="0,0,10,0">
                                        <Image Source="pack://application:,,,/Assets/icons/middle.png" Style="{StaticResource GameIcon}" Width="18" Height="18"/>
                                    </Border>
                                    <TextBlock Text="{DynamicResource ResSpins}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtSpinsCur" Grid.Column="1" Text="-" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                <TextBox x:Name="BoxSpins" Grid.Column="2" Style="{StaticResource DarkInput}" Text="99" Margin="0,0,8,0" KeyDown="Input_KeyDown" Tag="spins"/>
                                <Button Grid.Column="3" Style="{StaticResource PrimaryBtn}" Content="{DynamicResource BtnSet}" Padding="8,5" Margin="0,0,8,0" Click="BtnSetSpins_Click"/>
                                <StackPanel Grid.Column="4" Orientation="Horizontal">
                                    <Button Style="{StaticResource ModernBtn}" Content="+10" Width="76" Padding="6,5" Margin="0,0,6,0" Click="BtnAddSpins10_Click"/>
                                    <Button Style="{StaticResource ModernBtn}" Content="+50" Width="82" Padding="6,5" Click="BtnAddSpins50_Click"/>
                                </StackPanel>
                                <CheckBox x:Name="SwLockSpins" Grid.Column="5" Style="{StaticResource ToggleSwitch}" Content="{DynamicResource LblLock}"/>
                            </Grid>

                            <!-- Row 4: Free Spins -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="175"/>
                                    <ColumnDefinition Width="115"/>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="185"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="6" Background="#121420" BorderBrush="#2D334D" BorderThickness="1" Margin="0,0,10,0">
                                        <Image Source="pack://application:,,,/Assets/icons/star.png" Style="{StaticResource GameIcon}" Width="18" Height="18"/>
                                    </Border>
                                    <TextBlock Text="{DynamicResource ResFreeSpins}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtFreeSpinsCur" Grid.Column="1" Text="-" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                <TextBox x:Name="BoxFreeSpins" Grid.Column="2" Style="{StaticResource DarkInput}" Text="99" Margin="0,0,8,0" KeyDown="Input_KeyDown" Tag="freespins"/>
                                <Button Grid.Column="3" Style="{StaticResource PrimaryBtn}" Content="{DynamicResource BtnSet}" Padding="8,5" Margin="0,0,8,0" Click="BtnSetFreeSpins_Click"/>
                                <StackPanel Grid.Column="4" Orientation="Horizontal">
                                    <Button Style="{StaticResource ModernBtn}" Content="+10" Width="76" Padding="6,5" Margin="0,0,6,0" Click="BtnAddFreeSpins10_Click"/>
                                    <Button Style="{StaticResource ModernBtn}" Content="+50" Width="82" Padding="6,5" Click="BtnAddFreeSpins50_Click"/>
                                </StackPanel>
                                <CheckBox x:Name="SwLockFreeSpins" Grid.Column="5" Style="{StaticResource ToggleSwitch}" Content="{DynamicResource LblLock}"/>
                            </Grid>

                            <!-- Row 5: Core Free Rerolls -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="175"/>
                                    <ColumnDefinition Width="115"/>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="185"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="6" Background="#121420" BorderBrush="#2D334D" BorderThickness="1" Margin="0,0,10,0">
                                        <Image Source="pack://application:,,,/Assets/icons/reroll.png" Style="{StaticResource GameIcon}" Width="19" Height="19"/>
                                    </Border>
                                    <TextBlock Text="{DynamicResource ResCoreRerolls}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtRerollsCur" Grid.Column="1" Text="-" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                <TextBox x:Name="BoxRerolls" Grid.Column="2" Style="{StaticResource DarkInput}" Text="99" Margin="0,0,8,0" KeyDown="Input_KeyDown" Tag="rerolls"/>
                                <Button Grid.Column="3" Style="{StaticResource PrimaryBtn}" Content="{DynamicResource BtnSet}" Padding="8,5" Margin="0,0,8,0" Click="BtnSetRerolls_Click"/>
                                <StackPanel Grid.Column="4" Orientation="Horizontal">
                                    <Button Style="{StaticResource ModernBtn}" Content="+10" Width="76" Padding="6,5" Margin="0,0,6,0" Click="BtnAddRerolls10_Click"/>
                                    <Button Style="{StaticResource ModernBtn}" Content="+50" Width="82" Padding="6,5" Click="BtnAddRerolls50_Click"/>
                                </StackPanel>
                                <CheckBox x:Name="SwLockRerolls" Grid.Column="5" Style="{StaticResource ToggleSwitch}" Content="{DynamicResource LblLock}"/>
                            </Grid>

                            <!-- Row 6: Base HP -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="175"/>
                                    <ColumnDefinition Width="115"/>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="185"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="6" Background="#121420" BorderBrush="#2D334D" BorderThickness="1" Margin="0,0,10,0">
                                        <Image Source="pack://application:,,,/Assets/icons/hp.png" Style="{StaticResource GameIcon}" Width="18" Height="16"/>
                                    </Border>
                                    <TextBlock Text="{DynamicResource ResBaseHp}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtBaseHpCur" Grid.Column="1" Text="-" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentRed}" VerticalAlignment="Center"/>
                                <TextBox x:Name="BoxBaseHp" Grid.Column="2" Style="{StaticResource DarkInput}" Text="99" Margin="0,0,8,0" KeyDown="Input_KeyDown" Tag="basehp"/>
                                <Button Grid.Column="3" Style="{StaticResource PrimaryBtn}" Content="{DynamicResource BtnSet}" Padding="8,5" Margin="0,0,8,0" Click="BtnSetBaseHp_Click"/>
                                <StackPanel Grid.Column="4" Orientation="Horizontal">
                                    <Button Style="{StaticResource ModernBtn}" Content="+10" Width="76" Padding="6,5" Margin="0,0,6,0" Click="BtnAddBaseHp10_Click"/>
                                    <Button Style="{StaticResource ModernBtn}" Content="{DynamicResource BtnSet999}" Width="82" Padding="6,5" Click="BtnSetBaseHp999_Click"/>
                                </StackPanel>
                                <CheckBox x:Name="SwLockBaseHp" Grid.Column="5" Style="{StaticResource ToggleSwitch}" Content="{DynamicResource LblLock}"/>
                            </Grid>

                            <!-- Row 7: Originite -->
                            <Grid Margin="0,3,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="175"/>
                                    <ColumnDefinition Width="115"/>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="185"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="6" Background="#121420" BorderBrush="#2D334D" BorderThickness="1" Margin="0,0,10,0">
                                        <Image Source="pack://application:,,,/Assets/icons/originite_ui.png" Style="{StaticResource GameIcon}" Width="19" Height="19"/>
                                    </Border>
                                    <TextBlock Text="{DynamicResource ResOriginite}" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtOriginiteCur" Grid.Column="1" Text="-" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentPurple}" VerticalAlignment="Center"/>
                                <TextBox x:Name="BoxOriginite" Grid.Column="2" Style="{StaticResource DarkInput}" Text="9999" Margin="0,0,8,0" KeyDown="Input_KeyDown" Tag="originite"/>
                                <Button Grid.Column="3" Style="{StaticResource PrimaryBtn}" Content="{DynamicResource BtnSet}" Padding="8,5" Margin="0,0,8,0" Click="BtnSetOriginite_Click"/>
                                <StackPanel Grid.Column="4" Orientation="Horizontal">
                                    <Button Style="{StaticResource ModernBtn}" Content="+1000" Width="76" Padding="6,5" Margin="0,0,6,0" Click="BtnAddOriginite1k_Click"/>
                                    <Button Style="{StaticResource ModernBtn}" Content="+10000" Width="82" Padding="6,5" Click="BtnAddOriginite10k_Click"/>
                                </StackPanel>
                                <TextBlock Grid.Column="5" Text="{DynamicResource HintOriginite}" FontSize="11.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Card: Slot, Shop & Battle Toggles -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="{DynamicResource CardTogglesTitle}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentGold}" Margin="0,0,0,8"/>

                            <UniformGrid Columns="2" Margin="0">
                                <Border Background="#151825" BorderBrush="#262B42" BorderThickness="1" CornerRadius="8" Padding="11,8" Margin="0,0,8,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Source="pack://application:,,,/Assets/icons/gold.png" Style="{StaticResource GameIcon}" Width="20" Height="20" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource SwZeroSpinTitle}" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="{DynamicResource SwZeroSpinDesc}" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="SwZeroSpinCost" Grid.Column="2" Style="{StaticResource ToggleSwitch}" Checked="SwZeroSpinCost_Changed" Unchecked="SwZeroSpinCost_Changed"/>
                                    </Grid>
                                </Border>

                                <Border Background="#151825" BorderBrush="#262B42" BorderThickness="1" CornerRadius="8" Padding="11,8" Margin="4,0,0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Source="pack://application:,,,/Assets/icons/reroll.png" Style="{StaticResource GameIcon}" Width="20" Height="20" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource SwFreeShopTitle}" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="{DynamicResource SwFreeShopDesc}" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="SwFreeShopReroll" Grid.Column="2" Style="{StaticResource ToggleSwitch}" Checked="SwFreeShopReroll_Changed" Unchecked="SwFreeShopReroll_Changed"/>
                                    </Grid>
                                </Border>

                                <Border Background="#151825" BorderBrush="#262B42" BorderThickness="1" CornerRadius="8" Padding="11,8" Margin="0,0,8,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Source="pack://application:,,,/Assets/icons/joker_big.png" Style="{StaticResource GameIcon}" Width="22" Height="20" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource SwForceWinTitle}" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="{DynamicResource SwForceWinDesc}" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="SwForceWin" Grid.Column="2" Style="{StaticResource ToggleSwitch}" Checked="SwForceWin_Changed" Unchecked="SwForceWin_Changed"/>
                                    </Grid>
                                </Border>

                                <Border Background="#151825" BorderBrush="#262B42" BorderThickness="1" CornerRadius="8" Padding="11,8" Margin="4,0,0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Source="pack://application:,,,/Assets/icons/hp.png" Style="{StaticResource GameIcon}" Width="20" Height="18" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource SwGodAlliesTitle}" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="{DynamicResource SwGodAlliesDesc}" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="SwGodAllies" Grid.Column="2" Style="{StaticResource ToggleSwitch}"/>
                                    </Grid>
                                </Border>

                                <Border Background="#151825" BorderBrush="#262B42" BorderThickness="1" CornerRadius="8" Padding="11,8" Margin="0,0,8,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Source="pack://application:,,,/Assets/icons/boss.png" Style="{StaticResource GameIcon}" Width="20" Height="16" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{DynamicResource SwOneHitTitle}" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="{DynamicResource SwOneHitDesc}" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="SwOneHitEnemies" Grid.Column="2" Style="{StaticResource ToggleSwitch}"/>
                                    </Grid>
                                </Border>

                                <Border Background="#151825" BorderBrush="#262B42" BorderThickness="1" CornerRadius="8" Padding="11,8" Margin="4,0,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Style="{StaticResource SuccessBtn}" Padding="8,6" Click="BtnHealAllies_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="pack://application:,,,/Assets/icons/hp.png" Style="{StaticResource GameIcon}" Width="14" Height="12" Margin="0,0,6,0"/>
                                                <TextBlock Text="{DynamicResource BtnHealAllies}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Style="{StaticResource DangerBtn}" Padding="8,6" Click="BtnWeakenEnemies_Click">
                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="pack://application:,,,/Assets/icons/boss.png" Style="{StaticResource GameIcon}" Width="16" Height="13" Margin="0,0,6,0"/>
                                                <TextBlock Text="{DynamicResource BtnWeakenEnemies}"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- PAGE 2: Probability Editor -->
            <ScrollViewer x:Name="PageOdds" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                <StackPanel>
                    <!-- Card 1: Rarity Probabilities -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Image Source="pack://application:,,,/Assets/icons/odds_book.png" Style="{StaticResource GameIcon}" Width="24" Height="16" Margin="0,0,8,0"/>
                                    <TextBlock Text="{DynamicResource CardRarityTitle}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentGold}" VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtRaritySum" Text="" FontSize="12" Foreground="{StaticResource AccentGreen}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button Style="{StaticResource ModernBtn}" Content="{DynamicResource BtnRefreshRead}" Padding="10,4" Click="BtnRefreshOdds_Click"/>
                                </StackPanel>
                            </Grid>

                            <UniformGrid Columns="5" Margin="0,0,0,12">
                                <!-- Normal -->
                                <Border Background="#151825" BorderBrush="#383E5C" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,6,0">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource GradeNormal}" FontSize="13.5" FontWeight="Bold" Foreground="#FFFFFF"/>
                                        <TextBlock x:Name="TxtProbNormalCur" Text="-" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="BoxProbNormal" Style="{StaticResource DarkInput}" Text="80.3" TextChanged="RarityBox_TextChanged" KeyDown="RarityBox_KeyDown"/>
                                            <TextBlock Grid.Column="1" Text="%" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Advanced -->
                                <Border Background="#151825" BorderBrush="#2D523D" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="3,0">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource GradeAdvanced}" FontSize="13.5" FontWeight="Bold" Foreground="#99D9A6"/>
                                        <TextBlock x:Name="TxtProbAdvancedCur" Text="-" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="BoxProbAdvanced" Style="{StaticResource DarkInput}" Text="15" TextChanged="RarityBox_TextChanged" KeyDown="RarityBox_KeyDown"/>
                                            <TextBlock Grid.Column="1" Text="%" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Rare -->
                                <Border Background="#151825" BorderBrush="#2E4775" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="3,0">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource GradeRare}" FontSize="13.5" FontWeight="Bold" Foreground="#99BFFF"/>
                                        <TextBlock x:Name="TxtProbRareCur" Text="-" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="BoxProbRare" Style="{StaticResource DarkInput}" Text="4.5" TextChanged="RarityBox_TextChanged" KeyDown="RarityBox_KeyDown"/>
                                            <TextBlock Grid.Column="1" Text="%" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Legendary -->
                                <Border Background="#151825" BorderBrush="#6B441C" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="3,0">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource GradeLegendary}" FontSize="13.5" FontWeight="Bold" Foreground="#F59E3A"/>
                                        <TextBlock x:Name="TxtProbLegendaryCur" Text="-" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="BoxProbLegendary" Style="{StaticResource DarkInput}" Text="0.2" TextChanged="RarityBox_TextChanged" KeyDown="RarityBox_KeyDown"/>
                                            <TextBlock Grid.Column="1" Text="%" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Prism -->
                                <Border Background="#151825" BorderBrush="#6B2FA0" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="6,0,0,0">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource GradePrism}" FontSize="13.5" FontWeight="Bold" Foreground="#D966FF"/>
                                        <TextBlock x:Name="TxtProbPrismCur" Text="-" FontSize="11.5" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,8"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="BoxProbPrism" Style="{StaticResource DarkInput}" Text="0" TextChanged="RarityBox_TextChanged" KeyDown="RarityBox_KeyDown"/>
                                            <TextBlock Grid.Column="1" Text="%" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="5,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <WrapPanel VerticalAlignment="Center">
                                <Button Style="{StaticResource PrimaryBtn}" Content="{DynamicResource BtnApplyRarity}" Margin="0,0,8,0" Click="BtnApplyRarity_Click"/>
                                <Button Style="{StaticResource GoldBtn}" Content="{DynamicResource BtnPresetLeg}" Margin="0,0,8,0" Click="BtnPresetLegendary_Click"/>
                                <Button Style="{StaticResource ModernBtn}" BorderBrush="#A855F7" Foreground="#E9D5FF" Background="#3B1D5A" Content="{DynamicResource BtnPresetPrism}" Margin="0,0,8,0" Click="BtnPresetPrism_Click"/>
                                <Button Style="{StaticResource ModernBtn}" Content="{DynamicResource BtnPresetHalf}" Margin="0,0,8,0" Click="BtnPresetHalfLegPrism_Click"/>
                                <Button Style="{StaticResource ModernBtn}" Content="{DynamicResource BtnRestoreDefault}" Click="BtnRestoreRarity_Click"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Slot Force Win Probability -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="7" Background="#121420" BorderBrush="#2D334D" BorderThickness="1" Margin="0,0,12,0">
                                <Image Source="pack://application:,,,/Assets/icons/joker_big.png" Style="{StaticResource GameIcon}" Width="24" Height="22"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{DynamicResource CardForceWinTitle}" FontSize="13.5" FontWeight="Bold" Foreground="{StaticResource AccentGold}"/>
                                    <TextBlock x:Name="TxtForceWinCur" Text="-" FontSize="12.5" FontWeight="SemiBold" Foreground="{StaticResource AccentGreen}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource CardForceWinDesc}" FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="BoxForceWinProb" Style="{StaticResource DarkInput}" Width="74" Text="100" KeyDown="ForceWinBox_KeyDown"/>
                                <TextBlock Text="%" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="5,0,10,0"/>
                                <Button Style="{StaticResource PrimaryBtn}" Content="{DynamicResource BtnApply}" Margin="0,0,6,0" Click="BtnApplyForceWin_Click"/>
                                <Button Style="{StaticResource SuccessBtn}" Content="{DynamicResource BtnForce100}" Margin="0,0,6,0" Click="BtnForceWin100_Click"/>
                                <Button Style="{StaticResource ModernBtn}" Content="{DynamicResource BtnZero}" Click="BtnForceWin0_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Card 3: Class Symbol Weights -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="{DynamicResource CardSymbolsTitle}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentGold}"/>
                                <TextBlock Text="{DynamicResource CardSymbolsHint}" FontSize="11.5" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <UniformGrid Columns="6" Margin="0,0,0,12">
                                <Border Background="#151825" BorderBrush="#262B42" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,6,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Image Source="pack://application:,,,/Assets/icons/sym_W.png" Style="{StaticResource GameIcon}" Width="20" Height="20" Margin="0,0,6,0"/>
                                            <TextBlock Text="{DynamicResource SymW}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtSymWCur" Text="-" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="BoxSymW" Style="{StaticResource DarkInput}" Text="20" KeyDown="SymbolBox_KeyDown"/>
                                            <TextBlock Grid.Column="1" Text="%" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Background="#151825" BorderBrush="#262B42" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="3,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Image Source="pack://application:,,,/Assets/icons/sym_A.png" Style="{StaticResource GameIcon}" Width="20" Height="20" Margin="0,0,6,0"/>
                                            <TextBlock Text="{DynamicResource SymA}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtSymACur" Text="-" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="BoxSymA" Style="{StaticResource DarkInput}" Text="20" KeyDown="SymbolBox_KeyDown"/>
                                            <TextBlock Grid.Column="1" Text="%" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Background="#151825" BorderBrush="#262B42" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="3,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Image Source="pack://application:,,,/Assets/icons/sym_S.png" Style="{StaticResource GameIcon}" Width="20" Height="20" Margin="0,0,6,0"/>
                                            <TextBlock Text="{DynamicResource SymS}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtSymSCur" Text="-" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="BoxSymS" Style="{StaticResource DarkInput}" Text="20" KeyDown="SymbolBox_KeyDown"/>
                                            <TextBlock Grid.Column="1" Text="%" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Background="#151825" BorderBrush="#262B42" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="3,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Image Source="pack://application:,,,/Assets/icons/sym_H.png" Style="{StaticResource GameIcon}" Width="20" Height="20" Margin="0,0,6,0"/>
                                            <TextBlock Text="{DynamicResource SymH}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtSymHCur" Text="-" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="BoxSymH" Style="{StaticResource DarkInput}" Text="15" KeyDown="SymbolBox_KeyDown"/>
                                            <TextBlock Grid.Column="1" Text="%" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Background="#151825" BorderBrush="#262B42" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="3,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Image Source="pack://application:,,,/Assets/icons/sym_M.png" Style="{StaticResource GameIcon}" Width="20" Height="20" Margin="0,0,6,0"/>
                                            <TextBlock Text="{DynamicResource SymM}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtSymMCur" Text="-" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="BoxSymM" Style="{StaticResource DarkInput}" Text="15" KeyDown="SymbolBox_KeyDown"/>
                                            <TextBlock Grid.Column="1" Text="%" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Background="#151825" BorderBrush="#262B42" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="6,0,0,0">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Image Source="pack://application:,,,/Assets/icons/sym_D.png" Style="{StaticResource GameIcon}" Width="20" Height="20" Margin="0,0,6,0"/>
                                            <TextBlock Text="{DynamicResource SymD}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                        <TextBlock x:Name="TxtSymDCur" Text="-" FontSize="11" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBox x:Name="BoxSymD" Style="{StaticResource DarkInput}" Text="10" KeyDown="SymbolBox_KeyDown"/>
                                            <TextBlock Grid.Column="1" Text="%" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource PrimaryBtn}" Content="{DynamicResource BtnApplySymbols}" Margin="0,0,8,0" Click="BtnApplySymbols_Click"/>
                                <Button Style="{StaticResource ModernBtn}" Content="{DynamicResource BtnEqualSymbols}" Margin="0,0,8,0" Click="BtnEqualSymbols_Click"/>
                                <Button Style="{StaticResource ModernBtn}" Content="{DynamicResource BtnRestoreSymbols}" Click="BtnRestoreSymbols_Click"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- PAGE 3: Roster Units -->
            <Grid x:Name="PageUnits" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Bulk Boost Toolbar -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                    <Button Style="{StaticResource PrimaryBtn}" Margin="0,0,8,0" Click="BtnRefreshUnits_Click" Content="{DynamicResource BtnRefreshUnits}"/>
                    <Button Style="{StaticResource DangerBtn}" Margin="0,0,8,0" Click="BtnBoostAtk_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/icons/atk.png" Style="{StaticResource GameIcon}" Width="14" Height="14" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource BtnBoostAtk}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource SuccessBtn}" Margin="0,0,8,0" Click="BtnBoostHp_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/icons/hp.png" Style="{StaticResource GameIcon}" Width="14" Height="12" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource BtnBoostHp}"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GoldBtn}" Click="BtnBoostAspd_Click">
                        <StackPanel Orientation="Horizontal">
                            <Image Source="pack://application:,,,/Assets/icons/aspd.png" Style="{StaticResource GameIcon}" Width="14" Height="14" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource BtnBoostAspd}"/>
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!-- Units Table -->
                <DataGrid x:Name="GridUnits" Grid.Row="1" Style="{StaticResource DarkDataGrid}" AutoGenerateColumns="False"
                          SelectionChanged="GridUnits_SelectionChanged" Margin="0,0,0,12">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="46"/>
                        <DataGridTextColumn x:Name="ColUnitSym" Header="Sym" Binding="{Binding Symbol}" Width="58"/>
                        <DataGridTextColumn x:Name="ColUnitName" Header="Unit" Binding="{Binding DisplayName}" Width="1.4*"/>
                        <DataGridTextColumn x:Name="ColUnitGrade" Header="Grade" Binding="{Binding GradeLabel}" Width="82"/>
                        <DataGridTextColumn x:Name="ColUnitRank" Header="Rank" Binding="{Binding Rank, StringFormat=0}" Width="62"/>
                        <DataGridTextColumn x:Name="ColUnitAbsorb" Header="Absorb" Binding="{Binding AbsorbLv, StringFormat=0}" Width="76"/>
                        <DataGridTextColumn x:Name="ColUnitAtk" Header="ATK" Binding="{Binding Atk, StringFormat=0.##}" Width="*"/>
                        <DataGridTextColumn x:Name="ColUnitHp" Header="HP" Binding="{Binding Hp, StringFormat=0.##}" Width="*"/>
                        <DataGridTextColumn x:Name="ColUnitAspd" Header="ASPD" Binding="{Binding Aspd, StringFormat=0.###}" Width="82"/>
                        <DataGridTextColumn x:Name="ColUnitSlots" Header="Slots" Binding="{Binding MaxImprintSlots, StringFormat=0}" Width="72"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Selected Unit Editor Card -->
                <Border Grid.Row="2" Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource CardUnitEditTitle}" FontSize="13" FontWeight="Bold" Foreground="{StaticResource AccentGold}" Margin="0,0,0,10"/>
                        <WrapPanel VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                                <Image Source="pack://application:,,,/Assets/icons/atk.png" Style="{StaticResource GameIcon}" Width="15" Height="15" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource LblAtk}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="BoxUnitAtk" Style="{StaticResource DarkInput}" Width="86" KeyDown="UnitBox_KeyDown"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                                <Image Source="pack://application:,,,/Assets/icons/hp.png" Style="{StaticResource GameIcon}" Width="15" Height="13" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource LblHp}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="BoxUnitHp" Style="{StaticResource DarkInput}" Width="86" KeyDown="UnitBox_KeyDown"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                                <Image Source="pack://application:,,,/Assets/icons/aspd.png" Style="{StaticResource GameIcon}" Width="14" Height="14" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource LblAspd}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="BoxUnitAspd" Style="{StaticResource DarkInput}" Width="72" KeyDown="UnitBox_KeyDown"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,14,0" VerticalAlignment="Center">
                                <Image Source="pack://application:,,,/Assets/icons/upgrade.png" Style="{StaticResource GameIcon}" Width="13" Height="16" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource LblAbsorb}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="BoxUnitAbsorb" Style="{StaticResource DarkInput}" Width="66" KeyDown="UnitBox_KeyDown"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                                <Image Source="pack://application:,,,/Assets/icons/star.png" Style="{StaticResource GameIcon}" Width="15" Height="15" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource LblSlots}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox x:Name="BoxUnitSlots" Style="{StaticResource DarkInput}" Width="58" KeyDown="UnitBox_KeyDown"/>
                            </StackPanel>

                            <Button Style="{StaticResource SuccessBtn}" Content="{DynamicResource BtnApplyUnit}" Padding="16,6" Click="BtnApplyUnit_Click"/>
                        </WrapPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- PAGE 4: Operation Log -->
            <Border x:Name="PageLogs" Style="{StaticResource CardBorder}" Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="{DynamicResource CardLogTitle}" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentGold}" VerticalAlignment="Center"/>
                        <Button Style="{StaticResource ModernBtn}" Content="{DynamicResource BtnClearLog}" Padding="10,4" HorizontalAlignment="Right" Click="BtnClearLog_Click"/>
                    </Grid>
                    <TextBox x:Name="TxtLog" Grid.Row="1" IsReadOnly="True" VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                             Background="{StaticResource BgInput}" Foreground="{StaticResource TextSecondary}"
                             BorderBrush="{StaticResource BorderBrushSubtle}" BorderThickness="1"
                             FontFamily="Cascadia Mono, Consolas, Microsoft YaHei UI" FontSize="12" Padding="10"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 4. Bottom Live Feedback Bar -->
        <Border Grid.Row="3" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderBrushSubtle}" BorderThickness="0,1,0,0" Padding="18,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse x:Name="ToastDot" Grid.Column="0" Width="7" Height="7" Fill="{StaticResource AccentGreen}" Margin="0,0,8,0"/>
                <TextBlock x:Name="TxtToast" Grid.Column="1" Text="{DynamicResource ToastReady}"
                           FontSize="12" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="LuaJIT 2.1 GC64 · Safe RW Guard" FontSize="11" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
