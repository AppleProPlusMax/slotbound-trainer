<Window x:Class="SlotboundTrainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Slotbound 内存修改器"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="930" Height="815"
        MinWidth="880" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgCanvas}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Microsoft YaHei UI"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. Top Header Bar -->
        <Border Grid.Row="0" Background="{StaticResource BgSurface}" BorderBrush="{StaticResource BorderBrushSubtle}" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Native Slotbound Game Icon -->
                <Border Grid.Column="0" Width="46" Height="46" CornerRadius="10" Background="#131522"
                        BorderBrush="#353B5B" BorderThickness="1" Margin="0,0,14,0">
                    <Image Source="pack://application:,,,/Assets/app.ico" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>

                <!-- Connection Status & Live Run Info -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource AccentGold}" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TxtStatus" Text="正在搜索 Slotbound.exe 进程..." FontSize="14.5" FontWeight="Bold" Foreground="{StaticResource AccentGold}"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtGameInfo" Text="阶段: -   |   关卡: -   |   波次: -   |   队列单位: 0   |   战场我方/敌方: 0 / 0"
                               FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,5,0,0"/>
                </StackPanel>

                <!-- Header Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnUnlockAll" Style="{StaticResource DangerBtn}" Content="解除全部锁定" Margin="0,0,8,0" Click="BtnUnlockAll_Click"/>
                    <Button x:Name="BtnAttach" Style="{StaticResource PrimaryBtn}" Content="重新附加进程" Click="BtnAttach_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Navigation Bar -->
        <Border Grid.Row="1" Background="#151824" BorderBrush="{StaticResource BorderBrushSubtle}" BorderThickness="0,0,0,1" Padding="18,8">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="NavResources" Style="{StaticResource NavTabRadio}" IsChecked="True" Checked="NavTab_Checked">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/icons/gold.png" Style="{StaticResource GameIcon}" Width="16" Height="16" Margin="0,0,7,0"/>
                        <TextBlock Text="资源与开关" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavOdds" Style="{StaticResource NavTabRadio}" Checked="NavTab_Checked">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/icons/odds_book.png" Style="{StaticResource GameIcon}" Width="20" Height="14" Margin="0,0,7,0"/>
                        <TextBlock Text="概率修改" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavUnits" Style="{StaticResource NavTabRadio}" Checked="NavTab_Checked">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/icons/battle.png" Style="{StaticResource GameIcon}" Width="16" Height="16" Margin="0,0,7,0"/>
                        <TextBlock Text="我方单位属性" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavLogs" Style="{StaticResource NavTabRadio}" Checked="NavTab_Checked">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="pack://application:,,,/Assets/icons/core.png" Style="{StaticResource GameIcon}" Width="20" Height="14" Margin="0,0,7,0"/>
                        <TextBlock Text="运行日志" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </Border>

        <!-- 3. Main Content Pages -->
        <Grid Grid.Row="2" Margin="18,14">

            <!-- PAGE 1: Resources & Switches -->
            <ScrollViewer x:Name="PageResources" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Card: Core Numeric Resources -->
                    <Border Style="{StaticResource CardBorder}" Margin="0,0,0,10">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="核心数值修改" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentGold}"/>
                                <TextBlock Text="输入数值后点「设置」或按回车立即生效 · 图标与游戏内一一对应" FontSize="11.5"
                                           Foreground="{StaticResource TextMuted}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Column Header Hint -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="175"/>
                                    <ColumnDefinition Width="115"/>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="185"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="项目" FontSize="11.5" Foreground="{StaticResource TextMuted}" Margin="38,0,0,0"/>
                                <TextBlock Grid.Column="1" Text="当前实时值" FontSize="11.5" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Grid.Column="2" Text="目标数值" FontSize="11.5" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Grid.Column="4" Text="快捷增量" FontSize="11.5" Foreground="{StaticResource TextMuted}"/>
                                <TextBlock Grid.Column="5" Text="定时锁定" FontSize="11.5" Foreground="{StaticResource TextMuted}"/>
                            </Grid>

                            <!-- Row 1: Coins -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="175"/>
                                    <ColumnDefinition Width="115"/>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="185"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="6" Background="#121420" BorderBrush="#2D334D" BorderThickness="1" Margin="0,0,10,0">
                                        <Image Source="pack://application:,,,/Assets/icons/gold.png" Style="{StaticResource GameIcon}" Width="18" Height="18"/>
                                    </Border>
                                    <TextBlock Text="金币" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtCoinsCur" Grid.Column="1" Text="-" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentGold}" VerticalAlignment="Center"/>
                                <TextBox x:Name="BoxCoins" Grid.Column="2" Style="{StaticResource DarkInput}" Text="99999" Margin="0,0,8,0" KeyDown="Input_KeyDown" Tag="coins"/>
                                <Button Grid.Column="3" Style="{StaticResource PrimaryBtn}" Content="设置" Padding="8,5" Margin="0,0,8,0" Click="BtnSetCoins_Click"/>
                                <StackPanel Grid.Column="4" Orientation="Horizontal">
                                    <Button Style="{StaticResource ModernBtn}" Content="+1000" Width="76" Padding="6,5" Margin="0,0,6,0" Click="BtnAddCoins1k_Click"/>
                                    <Button Style="{StaticResource ModernBtn}" Content="+10000" Width="82" Padding="6,5" Click="BtnAddCoins10k_Click"/>
                                </StackPanel>
                                <CheckBox x:Name="SwLockCoins" Grid.Column="5" Style="{StaticResource ToggleSwitch}" Content="锁定"/>
                            </Grid>

                            <!-- Row 2: Essence (Jungsu) -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="175"/>
                                    <ColumnDefinition Width="115"/>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="185"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="6" Background="#121420" BorderBrush="#2D334D" BorderThickness="1" Margin="0,0,10,0">
                                        <Image Source="pack://application:,,,/Assets/icons/essence.png" Style="{StaticResource GameIcon}" Width="14" Height="20"/>
                                    </Border>
                                    <TextBlock Text="精华" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtJungsuCur" Grid.Column="1" Text="-" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold" Foreground="#60A5FA" VerticalAlignment="Center"/>
                                <TextBox x:Name="BoxJungsu" Grid.Column="2" Style="{StaticResource DarkInput}" Text="999" Margin="0,0,8,0" KeyDown="Input_KeyDown" Tag="jungsu"/>
                                <Button Grid.Column="3" Style="{StaticResource PrimaryBtn}" Content="设置" Padding="8,5" Margin="0,0,8,0" Click="BtnSetJungsu_Click"/>
                                <StackPanel Grid.Column="4" Orientation="Horizontal">
                                    <Button Style="{StaticResource ModernBtn}" Content="+50" Width="76" Padding="6,5" Margin="0,0,6,0" Click="BtnAddJungsu50_Click"/>
                                    <Button Style="{StaticResource ModernBtn}" Content="+500" Width="82" Padding="6,5" Click="BtnAddJungsu500_Click"/>
                                </StackPanel>
                                <CheckBox x:Name="SwLockJungsu" Grid.Column="5" Style="{StaticResource ToggleSwitch}" Content="锁定"/>
                            </Grid>

                            <!-- Row 3: Spins Left -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="175"/>
                                    <ColumnDefinition Width="115"/>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="185"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="6" Background="#121420" BorderBrush="#2D334D" BorderThickness="1" Margin="0,0,10,0">
                                        <Image Source="pack://application:,,,/Assets/icons/middle.png" Style="{StaticResource GameIcon}" Width="18" Height="18"/>
                                    </Border>
                                    <TextBlock Text="剩余旋转" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtSpinsCur" Grid.Column="1" Text="-" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                <TextBox x:Name="BoxSpins" Grid.Column="2" Style="{StaticResource DarkInput}" Text="99" Margin="0,0,8,0" KeyDown="Input_KeyDown" Tag="spins"/>
                                <Button Grid.Column="3" Style="{StaticResource PrimaryBtn}" Content="设置" Padding="8,5" Margin="0,0,8,0" Click="BtnSetSpins_Click"/>
                                <StackPanel Grid.Column="4" Orientation="Horizontal">
                                    <Button Style="{StaticResource ModernBtn}" Content="+10" Width="76" Padding="6,5" Margin="0,0,6,0" Click="BtnAddSpins10_Click"/>
                                    <Button Style="{StaticResource ModernBtn}" Content="+50" Width="82" Padding="6,5" Click="BtnAddSpins50_Click"/>
                                </StackPanel>
                                <CheckBox x:Name="SwLockSpins" Grid.Column="5" Style="{StaticResource ToggleSwitch}" Content="锁定"/>
                            </Grid>

                            <!-- Row 4: Free Spins -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="175"/>
                                    <ColumnDefinition Width="115"/>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="185"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="6" Background="#121420" BorderBrush="#2D334D" BorderThickness="1" Margin="0,0,10,0">
                                        <Image Source="pack://application:,,,/Assets/icons/star.png" Style="{StaticResource GameIcon}" Width="18" Height="18"/>
                                    </Border>
                                    <TextBlock Text="免费旋转次数" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtFreeSpinsCur" Grid.Column="1" Text="-" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                <TextBox x:Name="BoxFreeSpins" Grid.Column="2" Style="{StaticResource DarkInput}" Text="99" Margin="0,0,8,0" KeyDown="Input_KeyDown" Tag="freespins"/>
                                <Button Grid.Column="3" Style="{StaticResource PrimaryBtn}" Content="设置" Padding="8,5" Margin="0,0,8,0" Click="BtnSetFreeSpins_Click"/>
                                <StackPanel Grid.Column="4" Orientation="Horizontal">
                                    <Button Style="{StaticResource ModernBtn}" Content="+10" Width="76" Padding="6,5" Margin="0,0,6,0" Click="BtnAddFreeSpins10_Click"/>
                                    <Button Style="{StaticResource ModernBtn}" Content="+50" Width="82" Padding="6,5" Click="BtnAddFreeSpins50_Click"/>
                                </StackPanel>
                                <CheckBox x:Name="SwLockFreeSpins" Grid.Column="5" Style="{StaticResource ToggleSwitch}" Content="锁定"/>
                            </Grid>

                            <!-- Row 5: Core Free Rerolls -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="175"/>
                                    <ColumnDefinition Width="115"/>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="185"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="6" Background="#121420" BorderBrush="#2D334D" BorderThickness="1" Margin="0,0,10,0">
                                        <Image Source="pack://application:,,,/Assets/icons/reroll.png" Style="{StaticResource GameIcon}" Width="19" Height="19"/>
                                    </Border>
                                    <TextBlock Text="核心免费重掷" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtRerollsCur" Grid.Column="1" Text="-" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                <TextBox x:Name="BoxRerolls" Grid.Column="2" Style="{StaticResource DarkInput}" Text="99" Margin="0,0,8,0" KeyDown="Input_KeyDown" Tag="rerolls"/>
                                <Button Grid.Column="3" Style="{StaticResource PrimaryBtn}" Content="设置" Padding="8,5" Margin="0,0,8,0" Click="BtnSetRerolls_Click"/>
                                <StackPanel Grid.Column="4" Orientation="Horizontal">
                                    <Button Style="{StaticResource ModernBtn}" Content="+10" Width="76" Padding="6,5" Margin="0,0,6,0" Click="BtnAddRerolls10_Click"/>
                                    <Button Style="{StaticResource ModernBtn}" Content="+50" Width="82" Padding="6,5" Click="BtnAddRerolls50_Click"/>
                                </StackPanel>
                                <CheckBox x:Name="SwLockRerolls" Grid.Column="5" Style="{StaticResource ToggleSwitch}" Content="锁定"/>
                            </Grid>

                            <!-- Row 6: Base HP -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="175"/>
                                    <ColumnDefinition Width="115"/>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="185"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="6" Background="#121420" BorderBrush="#2D334D" BorderThickness="1" Margin="0,0,10,0">
                                        <Image Source="pack://application:,,,/Assets/icons/hp.png" Style="{StaticResource GameIcon}" Width="18" Height="16"/>
                                    </Border>
                                    <TextBlock Text="基地生命" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtBaseHpCur" Grid.Column="1" Text="-" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentRed}" VerticalAlignment="Center"/>
                                <TextBox x:Name="BoxBaseHp" Grid.Column="2" Style="{StaticResource DarkInput}" Text="99" Margin="0,0,8,0" KeyDown="Input_KeyDown" Tag="basehp"/>
                                <Button Grid.Column="3" Style="{StaticResource PrimaryBtn}" Content="设置" Padding="8,5" Margin="0,0,8,0" Click="BtnSetBaseHp_Click"/>
                                <StackPanel Grid.Column="4" Orientation="Horizontal">
                                    <Button Style="{StaticResource ModernBtn}" Content="+10" Width="76" Padding="6,5" Margin="0,0,6,0" Click="BtnAddBaseHp10_Click"/>
                                    <Button Style="{StaticResource ModernBtn}" Content="设为999" Width="82" Padding="6,5" Click="BtnSetBaseHp999_Click"/>
                                </StackPanel>
                                <CheckBox x:Name="SwLockBaseHp" Grid.Column="5" Style="{StaticResource ToggleSwitch}" Content="锁定"/>
                            </Grid>

                            <!-- Row 7: Originite -->
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="175"/>
                                    <ColumnDefinition Width="115"/>
                                    <ColumnDefinition Width="125"/>
                                    <ColumnDefinition Width="72"/>
                                    <ColumnDefinition Width="185"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Width="28" Height="28" CornerRadius="6" Background="#121420" BorderBrush="#2D334D" BorderThickness="1" Margin="0,0,10,0">
                                        <Image Source="pack://application:,,,/Assets/icons/originite_ui.png" Style="{StaticResource GameIcon}" Width="19" Height="19"/>
                                    </Border>
                                    <TextBlock Text="本局源石" FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock x:Name="TxtOriginiteCur" Grid.Column="1" Text="-" FontFamily="Segoe UI" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentPurple}" VerticalAlignment="Center"/>
                                <TextBox x:Name="BoxOriginite" Grid.Column="2" Style="{StaticResource DarkInput}" Text="9999" Margin="0,0,8,0" KeyDown="Input_KeyDown" Tag="originite"/>
                                <Button Grid.Column="3" Style="{StaticResource PrimaryBtn}" Content="设置" Padding="8,5" Margin="0,0,8,0" Click="BtnSetOriginite_Click"/>
                                <StackPanel Grid.Column="4" Orientation="Horizontal">
                                    <Button Style="{StaticResource ModernBtn}" Content="+1000" Width="76" Padding="6,5" Margin="0,0,6,0" Click="BtnAddOriginite1k_Click"/>
                                    <Button Style="{StaticResource ModernBtn}" Content="+10000" Width="82" Padding="6,5" Click="BtnAddOriginite10k_Click"/>
                                </StackPanel>
                                <TextBlock Grid.Column="5" Text="结算计入局外" FontSize="11.5" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Card: Slot, Shop & Battle Toggles -->
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel>
                            <TextBlock Text="老虎机、商店与战场功能" FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentGold}" Margin="0,0,0,8"/>

                            <UniformGrid Columns="2" Margin="0">
                                <Border Background="#151825" BorderBrush="#262B42" BorderThickness="1" CornerRadius="8" Padding="11,8" Margin="0,0,8,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Source="pack://application:,,,/Assets/icons/gold.png" Style="{StaticResource GameIcon}" Width="20" Height="20" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="免费无限付费旋转" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="费用归零且解除每波次数限制" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="SwZeroSpinCost" Grid.Column="2" Style="{StaticResource ToggleSwitch}" Checked="SwZeroSpinCost_Changed" Unchecked="SwZeroSpinCost_Changed"/>
                                    </Grid>
                                </Border>

                                <Border Background="#151825" BorderBrush="#262B42" BorderThickness="1" CornerRadius="8" Padding="11,8" Margin="4,0,0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Source="pack://application:,,,/Assets/icons/reroll.png" Style="{StaticResource GameIcon}" Width="20" Height="20" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="商店免费重掷" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="商店刷新商品费用归零" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="SwFreeShopReroll" Grid.Column="2" Style="{StaticResource ToggleSwitch}" Checked="SwFreeShopReroll_Changed" Unchecked="SwFreeShopReroll_Changed"/>
                                    </Grid>
                                </Border>

                                <Border Background="#151825" BorderBrush="#262B42" BorderThickness="1" CornerRadius="8" Padding="11,8" Margin="0,0,8,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Source="pack://application:,,,/Assets/icons/joker_big.png" Style="{StaticResource GameIcon}" Width="22" Height="20" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="老虎机每次必中" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="锁定原生 forceWinOnce 必中" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="SwForceWin" Grid.Column="2" Style="{StaticResource ToggleSwitch}" Checked="SwForceWin_Changed" Unchecked="SwForceWin_Changed"/>
                                    </Grid>
                                </Border>

                                <Border Background="#151825" BorderBrush="#262B42" BorderThickness="1" CornerRadius="8" Padding="11,8" Margin="4,0,0,7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Source="pack://application:,,,/Assets/icons/hp.png" Style="{StaticResource GameIcon}" Width="20" Height="18" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="我方全员无敌" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="战斗中实时将存活单位锁满血" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="SwGodAllies" Grid.Column="2" Style="{StaticResource ToggleSwitch}"/>
                                    </Grid>
                                </Border>

                                <Border Background="#151825" BorderBrush="#262B42" BorderThickness="1" CornerRadius="8" Padding="11,8" Margin="0,0,8,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Image Source="pack://application:,,,/Assets/icons/boss.png" Style="{StaticResource GameIcon}" Width="20" Height="16" Margin="0,0,10,0"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="敌人自动残血 (1 HP)" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="一碰即死，正常触发击杀奖励" FontSize="11" Foreground="{StaticResource TextMuted}"/>
                                        </StackPanel>
                                        <CheckBox x:Name="SwOneHitEnemies" Grid.Column="2" Style="{StaticResource ToggleSwitch}"/>
                                    </Grid>
                                </Border>

                                <Border Background="#151825" BorderBrush="#262B42" BorderThickness="1" CornerRadius="8" Padding="11,8" Margin="4,0,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Style="{StaticResource SuccessBtn}" Padding="8,6" Click="BtnHealAllies_Click">
                                            <StackPanel Orientation="Horizontal">
