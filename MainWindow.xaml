                                            <StackPanel Orientation="Horizontal">
                                                <Image Source="pack://application:,,,/Assets/icons/boss.png" Style="{StaticResource GameIcon}" Width="16" Height="13" Margin="0,0,6,0"/>
                                                <TextBlock Text="场上敌人残血"/>
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- PAGE 2: Probability Editor -->
