                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtRaritySum" Text="当前输入总和: 100.0%" FontSize="12" Foreground="{StaticResource AccentGreen}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                    <Button Style="{StaticResource ModernBtn}" Content="刷新读取" Padding="10,4" Click="BtnRefreshOdds_Click"/>
                                </StackPanel>
                            </Grid>

                            <UniformGrid Columns="5" Margin="0,0,0,12">
